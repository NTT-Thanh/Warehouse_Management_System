DROP DATABASE IF EXISTS warehouse;
CREATE DATABASE warehouse CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE warehouse;

-- 1. Bảng Kho (warehouses): Lưu thông tin các kho hàng của hệ thống
CREATE TABLE warehouses (
    id INT AUTO_INCREMENT PRIMARY KEY,                -- Mã định danh kho (Khóa chính, tự tăng)
    name VARCHAR(100) NOT NULL,                       -- Tên kho hàng (Ví dụ: Kho tổng Hưng Yên)
    address VARCHAR(255),                             -- Địa chỉ chi tiết của kho
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP    -- Thời gian tạo bản ghi
);

-- 2. Bảng Khu vực trong kho (zones): Phân chia kho thành các khu vực lớn (Khu A, Khu B...)
CREATE TABLE zones (
    id INT AUTO_INCREMENT PRIMARY KEY,                -- Mã định danh khu vực (Khóa chính, tự tăng)
    warehouse_id INT NOT NULL,                        -- Thuộc kho nào (Khóa ngoại trỏ tới bảng warehouses)
    name VARCHAR(50) NOT NULL,                        -- Tên khu vực (Ví dụ: Khu A - Điện tử)
    FOREIGN KEY (warehouse_id) REFERENCES warehouses(id) ON DELETE CASCADE
);

-- 3. Bảng Dãy kệ (racks): Các dãy kệ đặt trong từng khu vực
CREATE TABLE racks (
    id INT AUTO_INCREMENT PRIMARY KEY,                -- Mã định danh dãy kệ (Khóa chính, tự tăng)
    zone_id INT NOT NULL,                             -- Thuộc khu vực nào (Khóa ngoại trỏ tới bảng zones)
    name VARCHAR(50) NOT NULL,                        -- Tên hoặc mã dãy kệ (Ví dụ: Kệ A1)
    FOREIGN KEY (zone_id) REFERENCES zones(id) ON DELETE CASCADE
);

-- 4. Bảng Tầng kệ (shelves): Các tầng nằm trên một dãy kệ
CREATE TABLE shelves (
    id INT AUTO_INCREMENT PRIMARY KEY,                -- Mã định danh tầng kệ (Khóa chính, tự tăng)
    rack_id INT NOT NULL,                             -- Thuộc dãy kệ nào (Khóa ngoại trỏ tới bảng racks)
    name VARCHAR(50) NOT NULL,                        -- Tên hoặc số thứ tự tầng (Ví dụ: Tầng 1, Tầng 2)
    FOREIGN KEY (rack_id) REFERENCES racks(id) ON DELETE CASCADE
);

-- 5. Bảng Ô chứa hàng (bins): Các ô/khay nhỏ nằm trên tầng kệ để chứa hàng hóa cụ thể
CREATE TABLE bins (
    id INT AUTO_INCREMENT PRIMARY KEY,                -- Mã định danh ô chứa (Khóa chính, tự tăng)
    shelf_id INT NOT NULL,                            -- Thuộc tầng kệ nào (Khóa ngoại trỏ tới bảng shelves)
    name VARCHAR(50) NOT NULL,                        -- Tên hoặc mã ô chứa (Ví dụ: Bin-A1-01)
    FOREIGN KEY (shelf_id) REFERENCES shelves(id) ON DELETE CASCADE
);

-- 6. Bảng Vị trí chi tiết (locations): Định vị toàn diện dùng để gán nhãn vị trí cho hàng hóa
CREATE TABLE locations (
id INT AUTO_INCREMENT PRIMARY KEY,                -- Mã định danh vị trí (Khóa chính, tự tăng)
bin_id INT,                                       -- Liên kết đến ô chứa cụ thể (Khóa ngoại trỏ tới bảng bins)
    code VARCHAR(100) UNIQUE NOT NULL,                -- Mã vị trí chuẩn dùng để quét mã vạch (Barcode/QR)
    description TEXT,                                 -- Mô tả chi tiết về vị trí này
    FOREIGN KEY (bin_id) REFERENCES bins(id) ON DELETE SET NULL
);

-- 7. Bảng Danh mục sản phẩm (categories): Phân loại hàng hóa trong kho
CREATE TABLE categories (
    id INT AUTO_INCREMENT PRIMARY KEY,                -- Mã định danh danh mục (Khóa chính, tự tăng)
    name VARCHAR(100) NOT NULL,                       -- Tên danh mục (Ví dụ: Linh kiện điện tử)
    description TEXT                                  -- Mô tả chi tiết về danh mục
);

-- 8. Bảng Sản phẩm / SKU (products): Lưu thông tin chi tiết từng mặt hàng lưu kho (đã bỏ trường giá)
CREATE TABLE products (
    id INT AUTO_INCREMENT PRIMARY KEY,                -- Mã định danh sản phẩm (Khóa chính, tự tăng)
    sku VARCHAR(50) UNIQUE NOT NULL,                  -- Mã SKU quản lý hàng hóa (Mã vạch định danh duy nhất)
    name VARCHAR(150) NOT NULL,                       -- Tên sản phẩm hàng hóa
    category_id INT,                                  -- Thuộc danh mục nào (Khóa ngoại trỏ tới bảng categories)
    unit VARCHAR(20) DEFAULT 'pcs',                   -- Đơn vị tính (Ví dụ: cái, hộp, kg, thùng)
    min_stock_level INT DEFAULT 5,                    -- Mức tồn kho tối thiểu để cảnh báo thiếu hàng (Low stock alert)
    FOREIGN KEY (category_id) REFERENCES categories(id) ON DELETE SET NULL
);

-- 9. Bảng Người dùng hệ thống (users): Quản lý tài khoản nhân viên và quyền hạn truy cập
CREATE TABLE users (
    id INT AUTO_INCREMENT PRIMARY KEY,                -- Mã định danh người dùng (Khóa chính, tự tăng)
    username VARCHAR(50) UNIQUE NOT NULL,             -- Tên đăng nhập hệ thống
    password VARCHAR(255) NOT NULL,                   -- Mật khẩu tài khoản (đã mã hóa)
    full_name VARCHAR(100),                           -- Họ và tên đầy đủ của nhân viên
    role ENUM('admin', 'staff', 'manager') DEFAULT 'staff', -- Phân quyền hệ thống (Quản trị viên, Nhân viên, Quản lý kho)
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP    -- Thời gian tạo tài khoản
);

-- 10. Bảng Tồn kho (inventory): Bảng trung gian theo dõi số lượng thực tế của sản phẩm tại từng ô chứa
-- Nếu bạn muốn thay thế bảng inventory cũ hoặc chỉnh sửa lại:

CREATE TABLE inventory (
    id INT AUTO_INCREMENT PRIMARY KEY,
    product_id INT NOT NULL,                      -- Mã sản phẩm
    bin_id INT NOT NULL,                          -- Ô chứa hàng
    batch_id INT NOT NULL,                        -- Lô hàng cụ thể
quantity INT DEFAULT 0,                       -- Số lượng tồn của lô này tại ô này
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE CASCADE,
    FOREIGN KEY (bin_id) REFERENCES bins(id) ON DELETE CASCADE,
    FOREIGN KEY (batch_id) REFERENCES batches(id) ON DELETE CASCADE
);
CREATE TABLE batches (
    id INT AUTO_INCREMENT PRIMARY KEY,
    batch_code VARCHAR(100) UNIQUE NOT NULL,      -- Mã lô hàng (Ví dụ: LOT-202609-01)
    product_id INT NOT NULL,                      -- Thuộc sản phẩm nào
    mfg_date DATE,                                -- Ngày sản xuất
    exp_date DATE,                                -- Hạn sử dụng
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE CASCADE
);
CREATE TABLE inventory_audits (
    id INT AUTO_INCREMENT PRIMARY KEY,
    audit_code VARCHAR(50) UNIQUE NOT NULL,       -- Mã phiếu kiểm kê (Ví dụ: AUD-202609-001)
    created_by INT NOT NULL,                      -- Nhân viên tạo phiếu (trỏ tới bảng users)
    status ENUM('Draft', 'In_Progress', 'Completed', 'Cancelled') DEFAULT 'Draft', -- Trạng thái kiểm kê
    note TEXT,                                    -- Ghi chú đợt kiểm kê
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (created_by) REFERENCES users(id)
);
CREATE TABLE audit_details (
    id INT AUTO_INCREMENT PRIMARY KEY,
    audit_id INT NOT NULL,                        -- Thuộc phiếu kiểm kê nào
    bin_id INT NOT NULL,                          -- Vị trí kiểm tra
    product_id INT NOT NULL,                      -- Sản phẩm kiểm tra
    batch_id INT,                                 -- Lô hàng (nếu kiểm tra chi tiết theo lô)
    system_quantity INT NOT NULL,                 -- Số lượng hệ thống ghi nhận trước khi kiểm
    actual_quantity INT DEFAULT 0,                -- Số lượng thực tế nhân viên đếm được (pcs)
    variance INT GENERATED ALWAYS AS (actual_quantity - system_quantity) STORED, -- Độ chênh lệch tự động tính
    status ENUM('Pending', 'Matched', 'Discrepancy') DEFAULT 'Pending', -- Trạng thái khớp hay lệch
    FOREIGN KEY (audit_id) REFERENCES inventory_audits(id) ON DELETE CASCADE,
    FOREIGN KEY (bin_id) REFERENCES bins(id) ON DELETE CASCADE,
    FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE CASCADE,
    FOREIGN KEY (batch_id) REFERENCES batches(id) ON DELETE SET NULL
);
-- 1. Bảng Nhà cung cấp (suppliers): Quản lý danh sách đối tác cung cấp hàng hóa đầu vào
CREATE TABLE suppliers (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(150) NOT NULL,                   -- Tên nhà cung cấp
    phone VARCHAR(20),                            -- Số điện thoại liên hệ
email VARCHAR(100),                           -- Email liên hệ
    address VARCHAR(255),                         -- Địa chỉ nhà cung cấp
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 2. Bảng Đơn vị vận chuyển (shipping): Quản lý các hãng vận chuyển/shipper
CREATE TABLE shippings (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100) NOT NULL,                   -- Tên đơn vị vận chuyển (Ví dụ: Giao Hàng Nhanh, Viettel Post...)
    phone VARCHAR(20),                            -- Hotline hỗ trợ
    contact_person VARCHAR(100),                  -- Người liên hệ phụ trách
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
-- ==========================================
-- PHẦN QUẢN LÝ NHẬP KHO (INBOUND)
-- ==========================================

-- 1. Bảng đầu phiếu nhập kho
CREATE TABLE inbound_receipts (
    id INT AUTO_INCREMENT PRIMARY KEY,
    receipt_code VARCHAR(50) UNIQUE NOT NULL,       -- Mã phiếu nhập (Ví dụ: INB-202609-001)
    supplier_id INT NOT NULL,                       -- Thuộc nhà cung cấp nào (Khóa ngoại trỏ tới suppliers)
    created_by INT NOT NULL,                        -- Nhân viên tạo phiếu (Khóa ngoại trỏ tới users)
    status ENUM('Pending', 'Receiving', 'Completed', 'Cancelled') DEFAULT 'Pending', -- Trạng thái phiếu
    note TEXT,                                      -- Ghi chú phiếu nhập
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (supplier_id) REFERENCES suppliers(id) ON DELETE RESTRICT,
    FOREIGN KEY (created_by) REFERENCES users(id)
);

-- 2. Bảng chi tiết sản phẩm trong phiếu nhập kho
CREATE TABLE inbound_details (
    id INT AUTO_INCREMENT PRIMARY KEY,
    receipt_id INT NOT NULL,                        -- Thuộc phiếu nhập nào
    product_id INT NOT NULL,                        -- Sản phẩm nhập
    batch_id INT NOT NULL,                          -- Lô hàng tương ứng (mã lô khi nhập)
    expected_quantity INT NOT NULL,                 -- Số lượng dự kiến nhập
    actual_quantity INT DEFAULT 0,                  -- Số lượng thực tế nhận được
    FOREIGN KEY (receipt_id) REFERENCES inbound_receipts(id) ON DELETE CASCADE,
    FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE CASCADE,
    FOREIGN KEY (batch_id) REFERENCES batches(id) ON DELETE CASCADE
);

-- ==========================================
-- PHẦN QUẢN LÝ XUẤT HÀNG / GIAO HÀNG (OUTBOUND)
-- ==========================================

-- 3. Bảng đầu đơn hàng xuất / phiếu giao hàng
CREATE TABLE outbound_orders (
    id INT AUTO_INCREMENT PRIMARY KEY,
    order_code VARCHAR(50) UNIQUE NOT NULL,         -- Mã đơn hàng/phiếu xuất (Ví dụ: OUT-202609-001)
    customer_name VARCHAR(150),                     -- Tên khách hàng / Đối tác nhận
shipping_id INT,                                -- Đơn vị vận chuyển (Khóa ngoại trỏ tới shippings)
    tracking_code VARCHAR(100),                     -- Mã vận đơn của hãng vận chuyển
    created_by INT NOT NULL,                        -- Nhân viên xử lý (Khóa ngoại trỏ tới users)
    status ENUM('Pending', 'Allocated', 'Picking', 'Packing', 'Dispatched', 'Cancelled') DEFAULT 'Pending', -- Trạng thái đơn
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (shipping_id) REFERENCES shippings(id) ON DELETE SET NULL,
    FOREIGN KEY (created_by) REFERENCES users(id)
);

-- 4. Bảng chi tiết sản phẩm trong đơn hàng xuất
CREATE TABLE outbound_details (
    id INT AUTO_INCREMENT PRIMARY KEY,
    order_id INT NOT NULL,                          -- Thuộc đơn xuất nào
    product_id INT NOT NULL,                        -- Sản phẩm xuất
    ordered_quantity INT NOT NULL,                  -- Số lượng khách đặt
    picked_quantity INT DEFAULT 0,                  -- Số lượng thực tế đã nhặt được
    FOREIGN KEY (order_id) REFERENCES outbound_orders(id) ON DELETE CASCADE,
    FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE CASCADE
);
-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- 
-- Bảng quản lý nhiệm vụ lấy hàng giao cho nhân viên (Picker Tasks)
CREATE TABLE picking_tasks (
    id INT AUTO_INCREMENT PRIMARY KEY,
    order_id INT NOT NULL,                          -- Thuộc đơn hàng xuất nào
    order_detail_id INT NOT NULL,                   -- Thuộc dòng sản phẩm nào trong đơn hàng
    product_id INT NOT NULL,                        -- Sản phẩm cần lấy
    batch_id INT NOT NULL,                          -- Lấy từ lô nào
    bin_id INT NOT NULL,                            -- Lấy tại ô vị trí cụ thể nào trong kho
    assigned_to INT,                                -- Tài khoản nhân viên được giao task (trỏ tới users)
    required_quantity INT NOT NULL,                 -- Số lượng cần lấy tại vị trí này
    picked_quantity INT DEFAULT 0,                  -- Số lượng thực tế nhân viên quét/lấy được
    status ENUM('Pending', 'Assigned', 'In_Progress', 'Completed', 'Short_Picked', 'Cancelled') DEFAULT 'Pending', -- Trạng thái task
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (order_id) REFERENCES outbound_orders(id) ON DELETE CASCADE,
    FOREIGN KEY (order_detail_id) REFERENCES outbound_details(id) ON DELETE CASCADE,
    FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE CASCADE,
    FOREIGN KEY (batch_id) REFERENCES batches(id) ON DELETE CASCADE,
    FOREIGN KEY (bin_id) REFERENCES bins(id) ON DELETE CASCADE,
    FOREIGN KEY (assigned_to) REFERENCES users(id) ON DELETE SET NULL
);
select*from picking_tasks;
select*from outbound_orders;
select*from outbound_details;
-- Bảng quản lý nhiệm vụ cất hàng vào vị trí (Putaway Tasks)
CREATE TABLE putaway_tasks (
    id INT AUTO_INCREMENT PRIMARY KEY,
    receipt_id INT NOT NULL,                        -- Thuộc phiếu nhập kho nào
    receipt_detail_id INT NOT NULL,                 -- Thuộc dòng chi tiết phiếu nhập nào
    product_id INT NOT NULL,                        -- Sản phẩm cần cất
    batch_id INT NOT NULL,                          -- Lô hàng tương ứng
    suggested_bin_id INT,                           -- Ô vị trí trống do hệ thống tự động gợi ý
    actual_bin_id INT,                              -- Ô vị trí thực tế nhân viên chọn/quét để cất vào
    assigned_to INT,                                -- Tài khoản nhân viên được giao task (trỏ tới users)
    quantity INT NOT NULL,                          -- Số lượng cần cất
    status ENUM('Pending', 'Assigned', 'In_Progress', 'Completed', 'Cancelled') DEFAULT 'Pending', -- Trạng thái task
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (receipt_id) REFERENCES inbound_receipts(id) ON DELETE CASCADE,
    FOREIGN KEY (receipt_detail_id) REFERENCES inbound_details(id) ON DELETE CASCADE,
    FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE CASCADE,
    FOREIGN KEY (batch_id) REFERENCES batches(id) ON DELETE CASCADE,
    FOREIGN KEY (suggested_bin_id) REFERENCES bins(id) ON DELETE SET NULL,
    FOREIGN KEY (actual_bin_id) REFERENCES bins(id) ON DELETE SET NULL,
    FOREIGN KEY (assigned_to) REFERENCES users(id) ON DELETE SET NULL
);


