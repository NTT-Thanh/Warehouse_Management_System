INSERT INTO locations (bin_id, code, description)
SELECT 
    b.id,
    CONCAT(
        SUBSTRING_INDEX(SUBSTRING_INDEX(r.name, ' ', -1), 'Kệ ', -1), 
        '-', 
        CAST(SUBSTRING_INDEX(b.name, '-', -1) AS UNSIGNED), 
        '-', 
        SUBSTRING_INDEX(s.name, ' ', -1)
    ),
    CONCAT('Vị trí ', r.name, ', ô ', b.name, ', ', s.name)
FROM bins b
JOIN shelves s ON b.shelf_id = s.id
JOIN racks r ON s.rack_id = r.id;



